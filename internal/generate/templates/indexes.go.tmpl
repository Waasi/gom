package {{.Package}}

import (
	"context"
{{- if .Indexes}}

	"go.mongodb.org/mongo-driver/bson"
	"go.mongodb.org/mongo-driver/mongo"
{{- end}}
)

func (m *{{.Name}}Model) EnsureIndexes(ctx context.Context) error {
{{- if .Indexes}}
	_, err := m.Collection().Indexes().CreateMany(ctx, []mongo.IndexModel{
{{- range .Indexes}}
		{Keys: bson.D{ {Key: "{{.}}", Value: 1} }},
{{- end}}
	})
	return err
{{- else}}
	return nil
{{- end}}
}
