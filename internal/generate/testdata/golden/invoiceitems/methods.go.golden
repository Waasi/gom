package invoiceitems

import (
	"context"
	"errors"
	"time"

	"github.com/waasi/gom/model"
	"go.mongodb.org/mongo-driver/bson"
)

func (i *InvoiceItem) Validate() error          { return model.Validator.Struct(i) }
func (i *InvoiceItem) SetCreatedAt(t time.Time) { i.CreatedAt = t }
func (i *InvoiceItem) SetUpdatedAt(t time.Time) { i.UpdatedAt = t }

// ErrNotPersisted is returned by Save, Reload and Delete when the record was
// not loaded from, or created through, InvoiceItemModel.
var ErrNotPersisted = errors.New("invoiceitems: InvoiceItem is not persisted")

// Save validates the record and writes all of its fields back.
func (i *InvoiceItem) Save(ctx context.Context) error {
	if i.collection == nil || i.ID.IsZero() {
		return ErrNotPersisted
	}
	if err := i.Validate(); err != nil {
		return err
	}
	i.SetUpdatedAt(time.Now())
	_, err := i.collection.ReplaceOne(ctx, bson.M{"_id": i.ID}, i)
	return err
}

// Reload replaces the record with its current state in the database.
func (i *InvoiceItem) Reload(ctx context.Context) error {
	if i.collection == nil || i.ID.IsZero() {
		return ErrNotPersisted
	}
	var fresh InvoiceItem
	if err := i.collection.FindOne(ctx, bson.M{"_id": i.ID}).Decode(&fresh); err != nil {
		return err
	}
	fresh.collection = i.collection
	*i = fresh
	return nil
}

// Delete removes the record.
func (i *InvoiceItem) Delete(ctx context.Context) error {
	if i.collection == nil || i.ID.IsZero() {
		return ErrNotPersisted
	}
	_, err := i.collection.DeleteOne(ctx, bson.M{"_id": i.ID})
	return err
}
