package invoiceitems

import (
	"go.mongodb.org/mongo-driver/bson/primitive"
	"go.mongodb.org/mongo-driver/mongo"
)

func (i *InvoiceItem) GetID() primitive.ObjectID   { return i.ID }
func (i *InvoiceItem) SetID(id primitive.ObjectID) { i.ID = id }
func (i *InvoiceItem) Bind(col *mongo.Collection)  { i.collection = col }
