package models

import (
	"example.com/app/models/invoices"
	"example.com/app/models/persons"
	"go.mongodb.org/mongo-driver/mongo"
)

// New builds every model against db. `gom generate model` adds an entry here.
func New(db *mongo.Database) *Models {
	return &Models{
		Invoice: *invoices.New(db),
		Person:  *persons.New(db),
	}
}
